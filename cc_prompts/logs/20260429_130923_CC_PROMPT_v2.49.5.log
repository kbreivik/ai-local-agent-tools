# Confirm POSTGRES_PASSWORD is set in docker/.env
# (POSTGRES_USER and POSTGRES_DB already are — confirmed earlier)
grep '^POSTGRES_PASSWORD=' docker/.env || echo "MISSING — add it before recreating pgbouncer"

